# Copie para .env e troque as senhas. NUNCA commite o .env.

# SQL Server (senha precisa ter 8+ caracteres com maiúscula, minúscula, número e símbolo)
MSSQL_SA_PASSWORD=Troque_Esta_Senha_SA1!
MSSQL_PORT=1433
NUTRIMENTE_DB_USER=nutrimente_app
NUTRIMENTE_DB_PASSWORD=Troque_Esta_Senha_App1!

# MongoDB (logs)
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=troque_esta_senha_root
MONGO_PORT=27017
MONGO_LOGS_DB=nutrimente_logs
MONGO_APP_USER=nutrimente_logs
MONGO_APP_PASSWORD=troque_esta_senha_logs

# Serviço de logs (Node.js)
LOGS_SERVICE_PORT=4000
LOGS_API_KEY=troque_esta_chave

# API Java (Spring Boot)
API_PORT=8080
# Chave que assina os tokens de login: 32+ caracteres aleatórios.
# Gere uma com:  openssl rand -base64 48
# A API assina com ela e o front (Next.js) confere com ela.
JWT_SECRET=troque_por_uma_chave_aleatoria_com_mais_de_32_caracteres
# Endereço do site, usado nos links dos e-mails
FRONTEND_URL=http://localhost:3000
# Primeiro administrador (criado quando a API liga pela 1ª vez)
ADMIN_EMAIL=admin@nutrimente.local
ADMIN_PASSWORD=Troque_Esta_Senha_Admin1

# Mailpit (e-mails de teste)
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Front-end (Next.js). O Next também lê este .env da raiz do projeto
# (inclusive o JWT_SECRET acima). Endereço da API visto pelo servidor do Next:
API_URL=http://localhost:8080
