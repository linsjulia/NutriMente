# =============================================================
# .env de PRODUÇÃO (servidor). O jeito mais fácil, NO SERVIDOR:
#   bash deploy/gerar-env.sh nutrimente.tech seu-email@exemplo.com
# (gera todas as senhas e chaves; depois só falta o e-mail, no fim)
# Ou à mão:  cp .env.production.example .env && nano .env
# Nunca envie o .env para o Git.
#
# Gere cada senha/chave com:  openssl rand -hex 24
# (use hex: os caracteres / + = do base64 quebram o endereço do MongoDB)
# (para as senhas do SQL Server, acrescente "Aa1!" no fim: ele exige
#  maiúscula, minúscula, número e símbolo)
# =============================================================

# Faz o "docker compose" usar os dois arquivos sem precisar do -f
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# ---------- Domínio ----------
# Sem https:// e sem www (o www é redirecionado sozinho)
DOMAIN=nutrimente.tech

# ---------- SQL Server ----------
MSSQL_SA_PASSWORD=TROQUE_gerada_com_openssl_Aa1!
NUTRIMENTE_DB_USER=nutrimente_app
NUTRIMENTE_DB_PASSWORD=TROQUE_outra_gerada_com_openssl_Aa1!
# Memória máxima do SQL Server em MB (2048 num VPS de 8 GB)
MSSQL_MEMORY_LIMIT_MB=2048

# ---------- MongoDB (logs) ----------
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=TROQUE
MONGO_LOGS_DB=nutrimente_logs
MONGO_APP_USER=nutrimente_logs
MONGO_APP_PASSWORD=TROQUE
LOGS_API_KEY=TROQUE

# ---------- API e login ----------
# 32+ caracteres. A MESMA chave é usada pela API e pelo site
JWT_SECRET=TROQUE_por_openssl_rand_hex_32
# Criptografa no banco: CPF, telefone, nascimento, prontuário, questionário,
# triagem, diário e as fotos/documentos. GUARDE UMA CÓPIA FORA DO SERVIDOR:
# sem ela, nem o backup abre esses dados. Nunca troque depois de no ar.
RECORDS_ENCRYPTION_KEY=TROQUE_por_openssl_rand_hex_32
AUTH_RATE_LIMIT_PER_MINUTE=30
# Memória máxima do container da API
API_MEMORY_LIMIT=1g

# Primeiro administrador (criado na primeira subida). Depois de entrar,
# troque a senha pela tela "Minha conta" e pode apagar ADMIN_PASSWORD daqui.
ADMIN_EMAIL=TROQUE_seu_email@exemplo.com
ADMIN_PASSWORD=TROQUE_Senha_Forte_1

# ---------- E-mail (SMTP de verdade) ----------
# Opção A (padrão): Brevo, grátis até 300 e-mails/dia. Porta 2525 porque a
# DigitalOcean BLOQUEIA as portas 25, 465 e 587 em contas novas.
# Usuário e senha SMTP: brevo.com > SMTP & API > SMTP (não é o seu login).
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=2525
MAIL_SSL=false
MAIL_STARTTLS=true
MAIL_USERNAME=TROQUE_login_smtp_do_brevo
MAIL_PASSWORD=TROQUE_chave_smtp_do_brevo
# Remetente: um endereço do SEU domínio, autenticado no Brevo (SPF/DKIM)
MAIL_FROM=NutriMente <nao-responda@nutrimente.tech>
#
# Opção B: e-mail da Hostinger (só em VPS que libera a porta 465)
#   MAIL_HOST=smtp.hostinger.com  MAIL_PORT=465  MAIL_SSL=true  MAIL_STARTTLS=false
#   MAIL_USERNAME=nao-responda@nutrimente.tech  (o remetente é a mesma caixa)
