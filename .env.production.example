# =============================================================
# .env de PRODUÇÃO (servidor). Copie para ".env" NO SERVIDOR:
#   cp .env.production.example .env && nano .env
# Nunca envie o .env para o Git.
#
# Gere cada senha/chave com:  openssl rand -hex 24
# (use hex: os caracteres / + = do base64 quebram o endereço do MongoDB)
# (para as senhas do SQL Server, acrescente "Aa1!" no fim: ele exige
#  maiúscula, minúscula, número e símbolo)
# =============================================================

# Faz o "docker compose" usar os dois arquivos sem precisar do -f
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# ---------- Domínio ----------
# Sem https:// e sem www (o www é redirecionado sozinho)
DOMAIN=nutrimente.com.br

# ---------- SQL Server ----------
MSSQL_SA_PASSWORD=TROQUE_gerada_com_openssl_Aa1!
NUTRIMENTE_DB_USER=nutrimente_app
NUTRIMENTE_DB_PASSWORD=TROQUE_outra_gerada_com_openssl_Aa1!
# Memória máxima do SQL Server em MB (2048 num VPS de 8 GB)
MSSQL_MEMORY_LIMIT_MB=2048

# ---------- MongoDB (logs) ----------
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=TROQUE
MONGO_LOGS_DB=nutrimente_logs
MONGO_APP_USER=nutrimente_logs
MONGO_APP_PASSWORD=TROQUE
LOGS_API_KEY=TROQUE

# ---------- API e login ----------
# 32+ caracteres. A MESMA chave é usada pela API e pelo site
JWT_SECRET=TROQUE_por_openssl_rand_hex_32
AUTH_RATE_LIMIT_PER_MINUTE=30
# Memória máxima do container da API
API_MEMORY_LIMIT=1g

# Primeiro administrador (criado na primeira subida). Depois de entrar,
# troque a senha pela tela "Minha conta" e pode apagar ADMIN_PASSWORD daqui.
ADMIN_EMAIL=admin@nutrimente.com.br
ADMIN_PASSWORD=TROQUE_Senha_Forte_1

# ---------- E-mail (SMTP de verdade) ----------
# E-mail da Hostinger (hPanel > E-mails): crie a caixa nao-responda@seudominio
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SSL=true
MAIL_STARTTLS=false
MAIL_USERNAME=nao-responda@nutrimente.com.br
MAIL_PASSWORD=TROQUE_senha_da_caixa_de_email
# O endereço do remetente precisa ser a mesma caixa do MAIL_USERNAME
MAIL_FROM=NutriMente <nao-responda@nutrimente.com.br>
