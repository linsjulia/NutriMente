// Configurações do VS Code compartilhadas pela equipe (vão para o Git).
// Coisas pessoais, como o caminho do Java na sua máquina, ficam nas
// configurações do USUÁRIO (Ctrl+Shift+P > "Preferences: Open User Settings (JSON)").
// Veja docs/INSTALACAO.md.
{
    // O CSS do projeto usa regras do Tailwind 4 (@theme, @custom-variant, @apply).
    // O validador de CSS do VS Code não as conhece e marcava "Unknown at rule".
    // Este arquivo ensina essas regras a ele (e mostra a documentação ao passar o mouse).
    "css.customData": [".vscode/tailwind.css-data.json"],

    // Análise de nulos da extensão Java (lê as anotações @NonNull/@Nullable
    // do Spring Boot 4). Fica LIGADA: ajuda a achar NullPointerException antes
    // de rodar. Se aparecer "Null type safety" numa referência de método
    // (ex.: User::canLogin), troque por uma lambda (u -> u.canLogin()).
    "java.compile.nullAnalysis.mode": "automatic",

    // Se o pom.xml mudar, a extensão Java atualiza o projeto sozinha
    "java.configuration.updateBuildConfiguration": "automatic"
}
