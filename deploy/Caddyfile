# =============================================================
# Caddy: a "porta de entrada" do site em produção.
#
# - Gera e renova SOZINHO o certificado HTTPS (Let's Encrypt). Basta o
#   domínio já apontar para o IP do servidor.
# - Repassa as visitas para o Next.js (serviço "web", porta 3000).
# - Acrescenta o IP real do visitante no X-Forwarded-For. A API usa esse IP
#   nos logs, no consentimento da LGPD e no limite de tentativas de login.
#
# {$DOMAIN} vem do .env (ex.: DOMAIN=nutrimente.com.br).
# =============================================================

# www.nutrimente.com.br -> nutrimente.com.br (um endereço só)
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	# Compacta as respostas (páginas carregam mais rápido)
	encode zstd gzip

	# HSTS: o navegador passa a usar SEMPRE HTTPS neste domínio (por 1 ano),
	# mesmo se alguém digitar http:// ou clicar num link antigo
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# Recusa envios gigantes. O maior envio é uma foto do diário alimentar ou
	# um documento do profissional (até 5 MB na API) mais os outros campos do
	# formulário: 6 MB dá a folga. Mudou o limite na API? Mude aqui também.
	request_body {
		max_size 6MB
	}

	reverse_proxy web:3000

	# Registro de acessos (docker compose logs caddy)
	log {
		output stdout
		format console
	}
}
